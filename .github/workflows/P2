name: PapersBot -> Teams

on:
  schedule:
    - cron: "0 0 * * *"   # 毎日 00:00 UTC = 09:00 JST
  workflow_dispatch:

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      # ★ posted.dat を cache から復元
      - name: Restore posted.dat cache
        id: cache-posted
        uses: actions/cache@v4
        with:
          path: posted.dat
          key: papersbot-posted-v1
          restore-keys: |
            papersbot-posted-v1

      - name: Run PapersBot and notify Teams
        shell: bash
        env:
          TEAMS_WEBHOOK_URL: ${{ secrets.TEAMS_WEBHOOK_URL }}
        run: |
          set -euo pipefail
          set -x

          test -n "${TEAMS_WEBHOOK_URL:-}" || { echo "❌ Secret empty"; exit 1; }

          python -m pip install --upgrade pip
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

          echo "=== posted.dat (before) ==="
          ls -la posted.dat || true
          tail -n 5 posted.dat || true

          export PYTHONFAULTHANDLER=1

          # ★ ここ重要：
          # posted.dat を更新して「次回以降スキップ」させたいので
          # --do-not-tweet を外して実行する（= posted.dat に記録される）
          #
          # ただし SNS 投稿はしたくない → SNS系の資格情報(secrets)を設定しない運用にする
          # （api接続に失敗して投稿されず、Teams送信だけ行う）
          python -u -X faulthandler papersbot.py > log.txt 2>&1 || {
            code=$?
            echo "❌ papersbot.py failed (exit=$code)"
            echo "=== last 200 lines of log.txt ==="
            tail -n 200 log.txt || true
            exit $code
          }

          echo "=== last 50 lines of log.txt (success) ==="
          tail -n 50 log.txt || true

          # Teams に送る JSON を作成（TWEET行から抽出、同一RUN内は DOI優先で重複排除）
          python - <<'PY' > payload.json
          import json, datetime, re

          text = open("log.txt", "r", encoding="utf-8", errors="replace").read()

          DOI_RE = re.compile(r'(10\.\d{4,9}/[^\s<>"\]\)]+)', re.IGNORECASE)

          def normalize_url(u: str) -> str:
              u = u.strip()
              u = re.sub(r'(\?|&)af=R\b', '', u)
              u = u.rstrip(').,;]')
              return u

          def extract_doi(url: str):
              m = re.search(r'https?://(?:dx\.)?doi\.org/(10\.\d{4,9}/.+)$', url, flags=re.IGNORECASE)
              if m:
                  doi = m.group(1).rstrip(').,;]')
                  return doi.lower()
              m = DOI_RE.search(url)
              if m:
                  return m.group(1).lower()
              return None

          items = []
          seen = set()

          for line in text.splitlines():
              line = line.strip()
              if not line.startswith("TWEET: "):
                  continue
              body = line[len("TWEET: "):].strip()

              m = re.match(r"(.+?)\s+(https?://\S+)$", body)
              if not m:
                  continue

              title = m.group(1).strip()
              url = normalize_url(m.group(2))

              doi = extract_doi(url)
              key = f"doi:{doi}" if doi else f"url:{url}"

              if key in seen:
                  continue
              seen.add(key)

              if len(title) > 140:
                  title = title[:137] + "..."
              items.append((title, url, doi))

          now = datetime.datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S UTC")

          if items:
              msg_lines = []
              for i, (t, u, d) in enumerate(items[:10], 1):
                  if d:
                      msg_lines.append(f"{i}. [{t}]({u})  (DOI: {d})")
                  else:
                      msg_lines.append(f"{i}. [{t}]({u})")
              msg = "\n".join(msg_lines)
          else:
              msg = "（新着なし）"

          payload = {
            "user_name": "PapersBot",
            "feedback_message": msg,
            "timestamp": now,
            "host": "github-actions",
          }
          print(json.dumps(payload, ensure_ascii=False))
          PY

          curl -sS --fail-with-body -X POST "$TEAMS_WEBHOOK_URL" \
            -H "Content-Type: application/json" \
            --data-binary @payload.json

          echo "=== posted.dat (after) ==="
          ls -la posted.dat || true
          tail -n 5 posted.dat || true
